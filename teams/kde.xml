<image>
	<profiles>
		<profile name="KDE-Desktop-Live" description="KDE Plasma Desktop Spin Live DVD">
			<requires profile="KDE-Desktop"/>
			<requires profile="LiveInstall"/>
		</profile>
		<profile name="KDE-Desktop-Disk" description="KDE Plasma Desktop Spin Install Disk">
			<requires profile="BootDiskCore"/>
			<requires profile="KDE-Desktop"/>
		</profile>
		<profile name="KDE-Mobile-Live" description="KDE Plasma Mobile Spin Live DVD">
			<requires profile="KDE-Mobile"/>
			<requires profile="LiveInstall"/>
		</profile>
		<profile name="KDE-Mobile-Disk" description="KDE Plasma Mobile Spin Install Disk">
			<requires profile="BootDiskCore"/>
			<requires profile="KDE-Mobile"/>
		</profile>
	</profiles>
	<packages type="bootstrap" patternType="onlyRequired" profiles="KDE-Desktop-Disk,KDE-Desktop-Live">
		<package name="fedora-release-kde"/>
		<!-- Essential Live ISO boot & session setup -->
		<package name="livesys-scripts"/>
		<package name="dracut-live"/>
		<package name="erofs-utils"/>

		<!-- Fedora 45 KDE Display Manager & First-Boot Setup (replaces SDDM) -->
		<!-- Required by plasmalogin-greeter & plasma-setup under onlyRequired -->
		<package name="plasma-login-manager"/>
		<package name="kcm-plasmalogin"/>
		<package name="plasma-setup"/>
		<package name="plasma-workspace"/>
		<package name="plasma-workspace-wayland"/>
		<package name="kwin-wayland"/>
		<package name="layer-shell-qt"/>
		<package name="qt6-qtwayland"/>
		<package name="xorg-x11-server-Xwayland"/>
		<package name="polkit-kde"/>
		<package name="xdg-desktop-portal-kde"/>
		<package name="breeze"/>
		<package name="qt6-qt5compat"/>
		<package name="qt6-qtsvg"/>
		<package name="qqc2-desktop-style"/>
		<package name="kirigami"/>
		<package name="kirigami-addons"/>
		<package name="plasma5support"/>
		<package name="kwayland"/>
		<package name="libplasma"/>
		<package name="breeze-icons"/>
		<package name="mesa-dri-drivers"/>
		<package name="mesa-vulkan-drivers"/>
		<package name="vulkan-loader"/>


		<package name="amd-gpu-firmware"/>
		<package name="intel-gpu-firmware"/>
		<package name="nvidia-gpu-firmware"/>
	</packages>
	<packages type="bootstrap" patternType="onlyRequired" profiles="KDE-Mobile-Disk,KDE-Mobile-Live">
		<package name="fedora-release-kde-mobile"/>
	</packages>
	<packages type="image" patternType="onlyRequired" profiles="KDE-Desktop-Disk,KDE-Desktop-Live">
		<package name="plasma-welcome-fedora"/>
	</packages>
</image>
